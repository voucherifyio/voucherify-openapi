{
  "openapi": "3.1.0",
  "info": {
    "title": "Voucherify Loyalty v2 API",
    "version": "2.0.0"
  },
  "tags": [
    {
      "name": "Programs",
      "description": "Programs"
    }
  ],
  "components": {
    "schemas": {
      "ProgramCreateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "note": { "type": ["string", "null"] }
        }
      },
      "ProgramCreateResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string" }
        }
      },
      "BadRequest": {
        "type": "object",
        "description": "Framework-level error returned when the raw request payload is rejected before reaching domain validation (for example, when it exceeds a configured size limit).",
        "properties": {
          "statusCode": {
            "type": "integer",
            "description": "HTTP status code of the error."
          },
          "error": {
            "type": "string",
            "description": "Short, human-readable description of the HTTP status."
          },
          "message": {
            "type": "string",
            "description": "Human-readable message with more details about the error."
          }
        }
      },
      "MemberActivity": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "member_id": { "type": "string" },
          "type": { "type": "string" }
        }
      },
      "MemberActivitySource": {
        "type": "object",
        "properties": {
          "id": { "type": "string" }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/v2/loyalties/programs": {
      "post": {
        "operationId": "createProgram",
        "tags": ["Programs"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProgramCreateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProgramCreateResponse"
                }
              }
            }
          },
          "400": {
            "description": "bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            }
          },
          "413": {
            "description": "Payload too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BadRequest"
                }
              }
            }
          }
        }
      }
    },
    "/v2/loyalties/programs/{programId}/members/{memberId}/activities": {
      "get": {
        "operationId": "listMemberActivities",
        "tags": ["Programs"],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MemberActivity"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
