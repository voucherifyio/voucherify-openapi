      "LoyaltyV2Member": {
        "title": "Loyalty Program Member",
        "type": "object",
        "description": "Loyalty v2 program member snapshot recorded with the activity.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^lmbr_[a-f0-9]+$",
            "description": "Unique member ID."
          },
          "customer_id": {
            "type": "string",
            "pattern": "^cust_[a-zA-Z0-9]+$",
            "description": "ID of the enrolled customer."
          },
          "program_id": {
            "type": "string",
            "pattern": "^lprg_[a-f0-9]+$",
            "description": "ID of the Loyalty v2 program."
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "DELETED"
            ],
            "description": "Member status."
          },
          "metadata": {
            "type": "object",
            "description": "Custom member metadata."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the member was created."
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Timestamp when the member was last updated, or `null`."
          },
          "object": {
            "type": "string",
            "const": "member",
            "description": "Object type. Always `member`."
          }
        },
        "required": [
          "id",
          "customer_id",
          "program_id",
          "status",
          "metadata",
          "created_at",
          "updated_at",
          "object"
        ]
      },
      "LoyaltyV2Program": {
        "title": "Loyalty Program",
        "type": "object",
        "description": "Loyalty v2 program snapshot recorded with the activity.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^lprg_[a-f0-9]+$",
            "description": "Unique program ID."
          },
          "name": {
            "type": "string",
            "description": "Program name."
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "ACTIVE",
              "INACTIVE",
              "DELETED"
            ],
            "description": "Program status."
          },
          "start_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Program start date, or `null` when not set."
          },
          "end_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Program end date, or `null` when not set."
          },
          "validity_hours": {
            "$ref": "#/components/schemas/LoyaltyV2ProgramValidityHours"
          },
          "metadata": {
            "type": "object",
            "description": "Custom program metadata."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the program was created."
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Timestamp when the program was last updated, or `null`."
          },
          "object": {
            "type": "string",
            "const": "program",
            "description": "Object type. Always `program`."
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "start_date",
          "end_date",
          "validity_hours",
          "metadata",
          "created_at",
          "updated_at",
          "object"
        ]
      },
      "LoyaltyV2Card": {
        "title": "Loyalty Card",
        "type": "object",
        "description": "Loyalty v2 card snapshot recorded with a member card activity.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^lcrd_[a-f0-9]+$",
            "description": "Unique card ID."
          },
          "program_id": {
            "type": "string",
            "pattern": "^lprg_[a-f0-9]+$",
            "description": "ID of the Loyalty v2 program."
          },
          "card_definition_id": {
            "type": "string",
            "pattern": "^lcdef_[a-f0-9]+$",
            "description": "ID of the card definition."
          },
          "card_type": {
            "type": "string",
            "enum": [
              "INDIVIDUAL"
            ],
            "description": "Type of loyalty card."
          },
          "code": {
            "type": [
              "string",
              "null"
            ],
            "description": "Human-readable card code, or `null` while code generation is pending."
          },
          "customer_id": {
            "type": "string",
            "pattern": "^cust_[a-zA-Z0-9]+$",
            "description": "ID of the customer assigned to the card."
          },
          "member_id": {
            "type": "string",
            "pattern": "^lmbr_[a-f0-9]+$",
            "description": "ID of the program member assigned to the card."
          },
          "lifetime_bucket": {
            "$ref": "#/components/schemas/LoyaltyV2CardLifetimeBucket"
          },
          "balance": {
            "$ref": "#/components/schemas/LoyaltyV2CardBalance"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the card was created."
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Timestamp when the card was last updated, or `null`."
          },
          "object": {
            "type": "string",
            "const": "card",
            "description": "Object type. Always `card`."
          }
        },
        "required": [
          "id",
          "program_id",
          "card_definition_id",
          "card_type",
          "code",
          "customer_id",
          "member_id",
          "lifetime_bucket",
          "balance",
          "created_at",
          "updated_at",
          "object"
        ]
      },
      "LoyaltyV2MemberCard": {
        "title": "Loyalty Member Card",
        "type": "object",
        "description": "Member assignment to a Loyalty v2 card.",
        "properties": {
          "member_role": {
            "type": "string",
            "enum": [
              "OWNER",
              "MEMBER"
            ],
            "description": "Role of the member on the card."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the card was assigned to the member."
          },
          "tier_progress": {
            "type": "object",
            "description": "Member tier progress on the card. Omitted when it was not included in the activity snapshot."
          },
          "card": {
            "description": "Card details, or `null` when the card is unavailable.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/LoyaltyV2CardSimple"
              },
              {
                "type": "object",
                "nullable": true,
                "default": null
              }
            ]
          },
          "object": {
            "type": "string",
            "const": "member_card",
            "description": "Object type. Always `member_card`."
          }
        },
        "required": [
          "member_role",
          "created_at",
          "card",
          "object"
        ]
      },
      "LoyaltyV2ProgramValidityHours": {
        "title": "Loyalty Program Validity Hours",
        "type": "object",
        "description": "Defines when the program is valid during a day.",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "ANY_TIME",
              "DAILY"
            ],
            "description": "Validity-hours mode."
          },
          "daily": {
            "type": "array",
            "description": "Daily validity windows. Omitted for `ANY_TIME`.",
            "items": {
              "type": "object",
              "properties": {
                "days_of_week": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "description": "Days of the week included in the window."
                },
                "start_time": {
                  "type": "string",
                  "description": "Start time of the window."
                },
                "end_time": {
                  "type": "string",
                  "description": "End time of the window."
                }
              },
              "required": [
                "days_of_week",
                "start_time",
                "end_time"
              ]
            }
          }
        },
        "required": [
          "type"
        ]
      },
      "LoyaltyV2CardLifetimeBucket": {
        "title": "Loyalty Card Lifetime Bucket",
        "type": "object",
        "description": "Lifetime point counters for a Loyalty v2 card.",
        "properties": {
          "points": {
            "$ref": "#/components/schemas/LoyaltyV2CardLifetimePoints"
          },
          "pending_points": {
            "$ref": "#/components/schemas/LoyaltyV2CardLifetimePendingPoints"
          }
        },
        "required": [
          "points",
          "pending_points"
        ]
      },
      "LoyaltyV2CardBalance": {
        "title": "Loyalty Card Balance",
        "type": "object",
        "description": "Current available balance of a Loyalty v2 card.",
        "properties": {
          "points": {
            "type": "number",
            "description": "Currently available active points."
          },
          "pending_points": {
            "type": "number",
            "description": "Currently pending points."
          }
        },
        "required": [
          "points",
          "pending_points"
        ]
      },
      "LoyaltyV2CardSimple": {
        "title": "Loyalty Card Simple",
        "type": "object",
        "description": "Loyalty v2 card snapshot embedded in a member card assignment.",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^lcrd_[a-f0-9]+$",
            "description": "Unique card ID."
          },
          "card_definition_id": {
            "type": "string",
            "pattern": "^lcdef_[a-f0-9]+$",
            "description": "ID of the card definition."
          },
          "card_type": {
            "type": "string",
            "enum": [
              "INDIVIDUAL"
            ],
            "description": "Type of loyalty card."
          },
          "code": {
            "type": [
              "string",
              "null"
            ],
            "description": "Human-readable card code, or `null` while code generation is pending."
          },
          "lifetime_bucket": {
            "$ref": "#/components/schemas/LoyaltyV2CardLifetimeBucket"
          },
          "balance": {
            "$ref": "#/components/schemas/LoyaltyV2CardBalance"
          },
          "next_expiration": {
            "description": "Nearest upcoming points expiration, or `null`.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/LoyaltyV2CardNextExpiration"
              },
              {
                "type": "object",
                "nullable": true,
                "default": null
              }
            ]
          },
          "next_activation": {
            "description": "Nearest upcoming pending-points activation, or `null`.",
            "oneOf": [
              {
                "$ref": "#/components/schemas/LoyaltyV2CardNextActivation"
              },
              {
                "type": "object",
                "nullable": true,
                "default": null
              }
            ]
          },
          "object": {
            "type": "string",
            "const": "card",
            "description": "Object type. Always `card`."
          }
        },
        "required": [
          "id",
          "card_definition_id",
          "card_type",
          "code",
          "lifetime_bucket",
          "balance",
          "next_expiration",
          "next_activation",
          "object"
        ]
      },
      "LoyaltyV2CardLifetimePoints": {
        "title": "Loyalty Card Lifetime Points",
        "type": "object",
        "description": "Lifetime counters for active points on a Loyalty v2 card.",
        "properties": {
          "total": {
            "type": "number",
            "description": "Total points credited to the card."
          },
          "earned": {
            "type": "number",
            "description": "Total points earned through earning rules."
          },
          "added": {
            "type": "number",
            "description": "Total points added manually."
          },
          "purchased": {
            "type": "number",
            "description": "Total points purchased through rewards."
          },
          "purchased_reversed": {
            "type": "number",
            "description": "Total purchased points reversed by reward refunds."
          },
          "subtracted": {
            "type": "number",
            "description": "Total points subtracted manually."
          },
          "expired": {
            "type": "number",
            "description": "Total points expired."
          },
          "spent": {
            "type": "number",
            "description": "Total points spent."
          },
          "refunded": {
            "type": "number",
            "description": "Total earned points refunded."
          },
          "returned": {
            "type": "number",
            "description": "Total points returned after reward refunds."
          },
          "locked": {
            "type": "number",
            "description": "Total locked points."
          },
          "unlocked": {
            "type": "number",
            "description": "Total unlocked points."
          }
        },
        "required": [
          "total",
          "earned",
          "added",
          "purchased",
          "purchased_reversed",
          "subtracted",
          "expired",
          "spent",
          "refunded",
          "returned",
          "locked",
          "unlocked"
        ]
      },
      "LoyaltyV2CardLifetimePendingPoints": {
        "title": "Loyalty Card Lifetime Pending Points",
        "type": "object",
        "description": "Lifetime counters for pending points on a Loyalty v2 card.",
        "properties": {
          "total": {
            "type": "number",
            "description": "Total pending points added."
          },
          "activated": {
            "type": "number",
            "description": "Total pending points activated."
          },
          "canceled": {
            "type": "number",
            "description": "Total pending points canceled."
          }
        },
        "required": [
          "total",
          "activated",
          "canceled"
        ]
      },
      "LoyaltyV2CardNextExpiration": {
        "title": "Loyalty Card Next Expiration",
        "type": "object",
        "description": "Nearest upcoming points expiration.",
        "properties": {
          "points": {
            "type": "number",
            "description": "Number of points that will expire."
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Date when the points expire."
          }
        },
        "required": [
          "points",
          "date"
        ]
      },
      "LoyaltyV2CardNextActivation": {
        "title": "Loyalty Card Next Activation",
        "type": "object",
        "description": "Nearest upcoming pending-points activation.",
        "properties": {
          "points": {
            "type": "number",
            "description": "Number of pending points."
          },
          "type": {
            "type": "string",
            "description": "Pending-points activation type."
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Scheduled activation date. Omitted for event-based activation."
          },
          "cancel_date": {
            "type": "string",
            "format": "date",
            "description": "Cancellation date for event-based activation."
          }
        },
        "required": [
          "points",
          "type"
        ]
      }
    }
  },
